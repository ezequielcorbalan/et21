---
interface Path { href: string; icon: string; title: string; description: string; linkLabel: string; }
interface Props { paths: Path[]; }

const { paths } = Astro.props;
---

<section class="container-et px-8 py-14 grid grid-cols-1 md:grid-cols-2 gap-5">
  {paths.map((path) => (
    <a
      href={path.href}
      class="group flex flex-col gap-4 p-8 bg-white border border-line rounded-2xl shadow-card-hover hover:shadow-card-lift transition-all hover:-translate-y-1"
    >
      <div class="text-[44px] leading-none">{path.icon}</div>
      <h3 class="text-[20px] font-bold text-ink leading-snug">{path.title}</h3>
      <p class="text-body text-[15px] leading-relaxed flex-1">{path.description}</p>
      <span class="text-[14px] font-semibold text-gold group-hover:text-gold-bright transition-colors">
        {path.linkLabel}
      </span>
    </a>
  ))}
</section>
