---
interface FaqItem { q: string; a: string; }
interface Props {
  id?: string;
  kicker: string;
  titleLine1: string;
  titleLine2Italic: string;
  sideText: string;
  sideCtaHref: string;
  sideCtaLabel: string;
  items: FaqItem[];
  withSchema?: boolean;
}

const {
  id,
  kicker,
  titleLine1,
  titleLine2Italic,
  sideText,
  sideCtaHref,
  sideCtaLabel,
  items,
  withSchema = true,
} = Astro.props;

const schemaData = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};
---

{withSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
)}

<section id={id} class="py-20 px-8 bg-cream">
  <div class="container-et">
    <!-- Section header -->
    <div class="mb-12">
      <div class="kicker">{kicker}</div>
      <h2 class="h-display text-[36px] md:text-[42px]">
        {titleLine1} <span class="italic-serif">{titleLine2Italic}</span>
      </h2>
    </div>

    <!-- Two-column layout: sidebar + accordion -->
    <div class="grid grid-cols-1 md:grid-cols-[300px_1fr] gap-12">
      <!-- Sidebar -->
      <div>
        <p class="text-body text-[15px] leading-relaxed mb-6">{sideText}</p>
        <a class="btn-ghost" href={sideCtaHref}>{sideCtaLabel} <span class="arrow">→</span></a>
      </div>

      <!-- Accordion using <details>/<summary> for accessibility -->
      <div class="flex flex-col gap-3">
        {items.map((item, i) => (
          <details
            open={i === 0}
            class="group border border-line rounded-xl bg-white overflow-hidden"
          >
            <summary class="flex items-center justify-between px-6 py-5 cursor-pointer list-none select-none text-[15px] font-semibold text-ink hover:bg-cream transition-colors">
              <span>{item.q}</span>
              <!-- Chevron icon rotates when open -->
              <span class="ml-4 shrink-0 text-[18px] text-muted transition-transform duration-200 group-open:rotate-45">+</span>
            </summary>
            <div class="px-6 pb-5 pt-1 text-[14px] text-body leading-relaxed border-t border-line">
              {item.a}
            </div>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>
