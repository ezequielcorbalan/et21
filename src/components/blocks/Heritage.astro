---
interface Fact { label: string; value: string; }
interface Props {
  id?: string;
  image: string;
  imageAlt: string;
  imageOverlay: string;
  kicker: string;
  titleLine1: string;
  titleLine2Italic: string;
  paragraphs: string[];
  facts: Fact[];
  ctaHref?: string;
  ctaLabel?: string;
}

const {
  id,
  image,
  imageAlt,
  imageOverlay,
  kicker,
  titleLine1,
  titleLine2Italic,
  paragraphs,
  facts,
  ctaHref,
  ctaLabel,
} = Astro.props;
---

<section id={id} class="py-20 px-8 bg-cream">
  <div class="container-et grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
    <!-- Image -->
    <div class="relative rounded-2xl overflow-hidden shadow-hero aspect-[4/3]">
      <img src={image} alt={imageAlt} class="w-full h-full object-cover" />
      <div class="absolute bottom-0 left-0 right-0 bg-navy/70 text-white text-[13px] font-medium text-center py-3 px-4">
        {imageOverlay}
      </div>
    </div>

    <!-- Body -->
    <div>
      <div class="kicker">{kicker}</div>
      <h2 class="h-display text-[36px] md:text-[42px] mb-6">
        {titleLine1} <span class="italic-serif">{titleLine2Italic}</span>
      </h2>

      <div class="flex flex-col gap-4 mb-8">
        {paragraphs.map((p) => (
          <p class="text-body text-[15px] leading-relaxed" set:html={p} />
        ))}
      </div>

      <!-- Fact list -->
      <div class="flex flex-col divide-y divide-line border-y border-line mb-8">
        {facts.map((f) => (
          <div class="flex items-center justify-between py-3">
            <strong class="text-[13px] font-bold text-ink">{f.label}</strong>
            <span class="text-[13px] text-body">{f.value}</span>
          </div>
        ))}
      </div>

      {ctaHref && ctaLabel && (
        <a class="btn-ghost" href={ctaHref}>
          {ctaLabel} <span class="arrow">→</span>
        </a>
      )}
    </div>
  </div>
</section>
