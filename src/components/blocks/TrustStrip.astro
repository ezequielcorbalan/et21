---
interface Stat { num: string; label: string; }
interface Props {
  kicker: string;
  titleLine1: string;
  titleLine2Italic: string;
  stats: Stat[];
}

const { kicker, titleLine1, titleLine2Italic, stats } = Astro.props;
---

<section class="bg-navy py-20 px-8">
  <div class="container-et">
    <!-- Head -->
    <div class="mb-12 text-center">
      <div class="kicker kicker-light">{kicker}</div>
      <h2 class="h-display text-[36px] md:text-[42px] text-white">
        {titleLine1} <span class="italic-serif text-gold-bright">{titleLine2Italic}</span>
      </h2>
    </div>

    <!-- Stats row -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
      {stats.map((s) => (
        <div class="flex flex-col items-center text-center gap-3">
          <div class="text-[48px] md:text-[56px] font-extrabold text-gold-bright leading-none tracking-tight">
            {s.num}
          </div>
          <div class="text-[14px] text-white/70 leading-snug max-w-[160px]">{s.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>
