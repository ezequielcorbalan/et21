---
interface Carrera {
  href: string;
  image: string;
  imageAlt: string;
  tag: string;
  title: string;
  meta: string;
  bullets: string[];
  length: string;
  linkLabel: string;
}
interface Props {
  kicker: string;
  titleLine1: string;
  titleLine2Italic: string;
  description: string;
  carreras: Carrera[];
}

const { kicker, titleLine1, titleLine2Italic, description, carreras } = Astro.props;
---

<section class="py-20 px-8">
  <div class="container-et">
    <!-- Section header -->
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-12">
      <div>
        <div class="kicker">{kicker}</div>
        <h2 class="h-display text-[36px] md:text-[42px]">
          {titleLine1} <span class="italic-serif">{titleLine2Italic}</span>
        </h2>
      </div>
      <p class="text-body text-[15px] leading-relaxed md:max-w-sm">{description}</p>
    </div>

    <!-- Carreras grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {carreras.map((c) => (
        <a
          href={c.href}
          class="group flex flex-col bg-white border border-line rounded-2xl overflow-hidden shadow-card-hover hover:shadow-card-lift transition-all hover:-translate-y-1"
        >
          <!-- Image -->
          <div class="relative aspect-[16/9] overflow-hidden">
            <img
              src={c.image}
              alt={c.imageAlt}
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
            <span class="absolute top-4 left-4 bg-navy text-gold-bright text-[11px] font-bold uppercase tracking-wider px-3 py-1.5 rounded-full">
              {c.tag}
            </span>
          </div>

          <!-- Body -->
          <div class="flex flex-col flex-1 p-7 gap-3">
            <h3 class="text-[22px] font-bold text-ink leading-snug">{c.title}</h3>
            <div class="text-[13px] font-semibold text-muted uppercase tracking-wider">{c.meta}</div>
            <ul class="flex flex-col gap-1.5 text-[14px] text-body">
              {c.bullets.map((b) => (
                <li class="flex items-start gap-2">
                  <span class="text-gold mt-0.5">—</span>
                  <span>{b}</span>
                </li>
              ))}
            </ul>
            <div class="flex items-center justify-between mt-auto pt-4 border-t border-line">
              <span class="text-[13px] text-muted">{c.length}</span>
              <span class="text-[14px] font-semibold text-gold group-hover:text-gold-bright transition-colors">
                {c.linkLabel}
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
