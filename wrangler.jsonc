{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "et21",
  "compatibility_date": "2026-04-22",
  "observability": {
    "enabled": true
  },
  "main": "dist/_worker.js/index.js",
  "compatibility_flags": [
    "global_fetch_strictly_public",
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "dist"
  },
  "routes": [
    { "pattern": "et21.ar", "custom_domain": true },
    { "pattern": "www.et21.ar", "custom_domain": true }
  ],
  "build": {
    "command": "npm run build"
  }
}
